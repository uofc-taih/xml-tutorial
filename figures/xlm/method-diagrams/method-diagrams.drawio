      <mxCell id="upper-title" value="Higher layer" style="text;html=0;align=center;verticalAlign=top;resizable=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=1;fontColor=#285f8f;" vertex="1" parent="upper-layer"><mxGeometry x="13.5" y="7.560000000000002" width="99" height="22" as="geometry"/></mxCell>
      <mxCell id="higher-token-next" value="next" style="text;html=0;align=left;verticalAlign=top;resizable=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;overflow=visible;spacing=0;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#24313d;" vertex="1" parent="upper-layer"><mxGeometry x="11" y="29.400000000000006" width="35" height="21" as="geometry"/></mxCell>
