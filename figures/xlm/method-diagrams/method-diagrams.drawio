<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="cbm-training" name="CBM training regimes">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1056" pageHeight="710" background="#ffffff" description="Training graphs for a strict concept bottleneck model. Independent training fits the concept predictor on reviews and concept annotations; the task predictor is fit separately on annotated concepts and task labels. Sequential training fits the concept predictor first, then fixes it and trains the task predictor on predicted concepts. Joint training adds task loss and a weighted concept loss; task gradients reach both predictors. At inference all three use the same path: review to concept predictor to predicted concepts to task predictor." sourceUrl="https://proceedings.mlr.press/v119/koh20a.html"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
